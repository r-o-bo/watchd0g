GEMINI_API_KEY=
GEMINI_MODEL=
REASONER_MODE=gemini
PROMETHEUS_URL=http://prometheus:9090
POLL_INTERVAL_SECONDS=5
MAX_LLM_CALLS_PER_HOUR=10
PLAYBOOK_COOLDOWN_SECONDS=60
AUTO_REMEDIATE_ENABLED=false
# Force every diagnosis to a low confidence (0.35) so the policy escalates
# instead of acting. Deterministic demo switch for the safety/low-confidence
# path; recreate the agent after changing it. Does not affect other behavior.
FORCE_LOW_CONFIDENCE=false
SLACK_WEBHOOK_URL=
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
